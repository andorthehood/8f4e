8f4e/v1

note
Bitwise instruction behavior
is checked with native
assertions.
noteEnd

entry test
module andAssertions
; `and` should return only the
; bits present in both operands.
push 1
push 0
and
push 0
assertEqual

push 3
push 6
and
push 2
assertEqual
moduleEnd

module orAssertions
; `or` should return the bits
; present in either operand.
push 1
push 0
or
push 1
assertEqual

push 3
push 6
or
push 7
assertEqual
moduleEnd

module xorAssertions
; `xor` should return only bits
; that differ between operands.
push 1
push 0
xor
push 1
assertEqual

push 3
push 6
xor
push 5
assertEqual
moduleEnd

module shiftLeftAssertions
; shiftLeft moves integer bits
; left by the requested amount.
push 1
push 1
shiftLeft
push 2
assertEqual

push 1
push 2
shiftLeft
push 4
assertEqual

push 3
push 3
shiftLeft
push 24
assertEqual
moduleEnd

module shiftRightAssertions
; shiftRight moves integer bits
; right by the requested amount.
push 1
push 1
shiftRight
push 0
assertEqual

push 8
push 2
shiftRight
push 2
assertEqual

push 12
push 3
shiftRight
push 1
assertEqual
moduleEnd
entryEnd
