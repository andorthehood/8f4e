{
	"name": "@8f4e/test-runner",
	"sourceRoot": "packages/test-runner/src",
	"projectType": "library",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "rm -rf dist && tsc --emitDeclarationOnly && vite build",
				"cwd": "{projectRoot}"
			}
		},
		"test": {
			"executor": "@nx/vitest:test",
			"dependsOn": ["^build"],
			"outputs": ["{workspaceRoot}/coverage/@8f4e/test-runner"],
			"options": {
				"config": "{projectRoot}/vitest.config.ts",
				"reportsDirectory": "{workspaceRoot}/coverage/@8f4e/test-runner"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "biome check --write packages/test-runner/src packages/test-runner/vite.config.ts packages/test-runner/vitest.config.ts",
				"cwd": "{workspaceRoot}"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc --noEmit -p tsconfig.test.json",
				"cwd": "{projectRoot}"
			}
		}
	},
	"tags": ["type:library", "scope:testing"]
}
