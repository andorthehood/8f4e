8f4e/v1

note
; @config runtime TestRuntime

Guard helpers normalize
invalid runtime values into
safe stack
values.
noteEnd

entry test
module ensureNonZeroIntAssertions
; ensureNonZero leaves non-zero
; integers unchanged and
; replaces
; zero with one.
push 69
ensureNonZero
assertEqual 69

push 0
ensureNonZero
assertEqual 1

push -420
ensureNonZero
assertEqual -420
moduleEnd

module ensureNonZeroFloatAssertions
; ensureNonZero leaves non-zero
; floats unchanged and replaces
; zero with 1.0.
push 69.1
ensureNonZero
assertEqual 69.1

push 0.0
ensureNonZero
assertEqual 1.0

push -420.1
ensureNonZero
assertEqual -420.1
moduleEnd
entryEnd
