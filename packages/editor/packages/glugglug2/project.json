{
	"name": "glugglug2",
	"sourceRoot": "src",
	"projectType": "library",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "tsc",
				"cwd": "{projectRoot}"
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc --watch",
				"cwd": "{projectRoot}"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "biome check --write packages/editor/packages/glugglug2",
				"cwd": "{workspaceRoot}"
			}
		},
		"test": {
			"executor": "@nx/vitest:test",
			"outputs": ["{workspaceRoot}/coverage/glugglug2"],
			"options": {
				"config": "{projectRoot}/vitest.config.ts",
				"reportsDirectory": "{workspaceRoot}/coverage/glugglug2"
			}
		},
		"test:screenshot": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"options": {
				"command": "playwright test",
				"cwd": "{projectRoot}"
			}
		},
		"test:screenshot:update": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"options": {
				"command": "playwright test --update-snapshots",
				"cwd": "{projectRoot}"
			}
		},
		"dev:test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vite --config screenshot-tests/vite.config.ts",
				"cwd": "{projectRoot}"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc --noEmit",
				"cwd": "{projectRoot}"
			}
		}
	},
	"tags": ["type:library", "scope:graphics"]
}
