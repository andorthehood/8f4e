includes
include std/events/hasChanged
includesEnd

entry test
module hasChangedFloatAssertions
; it returns true when a float
; value differs from its
; previous value and stores the
; current value.
float previousFloat

push 0.0
call hasChanged &previousFloat
push 0
assertEqual
push previousFloat
push 0.0
assertEqual

push 1.5
call hasChanged &previousFloat
push 1
assertEqual
push previousFloat
push 1.5
assertEqual

push 1.5
call hasChanged &previousFloat
push 0
assertEqual

push -0.75
call hasChanged &previousFloat
push 1
assertEqual
push previousFloat
push -0.75
assertEqual
moduleEnd
entryEnd
