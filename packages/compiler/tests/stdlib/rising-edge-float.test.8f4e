8f4e/v1

includes
include std/events/risingEdge
includesEnd

entry test
module risingEdgeFloatAssertions
; it returns true when a float
; value rises above its previous
; value and stores the current
; value.
float previousFloat

push 0.0
call risingEdge &previousFloat
push 0
assertEqual
push previousFloat
push 0.0
assertEqual

push 0.25
call risingEdge &previousFloat
push 1
assertEqual
push previousFloat
push 0.25
assertEqual

push 0.25
call risingEdge &previousFloat
push 0
assertEqual

push -0.5
call risingEdge &previousFloat
push 0
assertEqual

push 0.0
call risingEdge &previousFloat
push 1
assertEqual
moduleEnd
entryEnd
