8f4e/v1

note
; @config runtime TestRuntime

Comparison instructions return
integer booleans and are
checked with assert.
noteEnd

entry test
module equalAssertions
; equal returns true for
; matching integer operands and
; false
; otherwise.
push 420
push 420
equal
assertEqual 1

push 420
push -420
equal
assertEqual 0

push 69
push 96
equal
assertEqual 0

push 0
push 0
equal
assertEqual 1
moduleEnd

module equalToZeroAssertions
; equalToZero returns true only
; for zero.
push 420
equalToZero
assertEqual 0

push -69
equalToZero
assertEqual 0

push 0
equalToZero
assertEqual 1
moduleEnd

module greaterThanIntAssertions
; greaterThan compares signed
; integers.
push 420
push 420
greaterThan
assertEqual 0

push 420
push 0
greaterThan
assertEqual 1

push 0
push 0
greaterThan
assertEqual 0

push 0
push 69
greaterThan
assertEqual 0

push 0
push -69
greaterThan
assertEqual 1
moduleEnd

module greaterThanFloatAssertions
; greaterThan compares floats
; and still returns an integer
; boolean.
push 420.1
push 420.1
greaterThan
assertEqual 0

push 420.1
push 0.001
greaterThan
assertEqual 1

push 0.001
push 0.001
greaterThan
assertEqual 0

push 0.001
push 69.1
greaterThan
assertEqual 0

push 0.001
push -69.1
greaterThan
assertEqual 1
moduleEnd

module greaterOrEqualIntAssertions
; greaterOrEqual returns true
; for equal or greater signed
; integers.
push 420
push 420
greaterOrEqual
assertEqual 1

push 420
push 0
greaterOrEqual
assertEqual 1

push 0
push 0
greaterOrEqual
assertEqual 1

push 0
push 69
greaterOrEqual
assertEqual 0

push 0
push -69
greaterOrEqual
assertEqual 1
moduleEnd

module greaterOrEqualFloatAssertions
; greaterOrEqual returns true
; for equal or greater floats.
push 420.1
push 420.1
greaterOrEqual
assertEqual 1

push 420.1
push 0.001
greaterOrEqual
assertEqual 1

push 0.001
push 0.001
greaterOrEqual
assertEqual 1

push 0.001
push 69.1
greaterOrEqual
assertEqual 0

push 0.001
push -69.1
greaterOrEqual
assertEqual 1
moduleEnd
entryEnd
