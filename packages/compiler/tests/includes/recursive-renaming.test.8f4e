entry test
module recursiveIncludeAssertions
; Recursion follows the renamed included definition.
call sumDown 3
push 6
assertEqual
call viaAlias 3
push 6
assertEqual

; Calls in project code keep their original targets.
call descend 3
push 100
assertEqual
call countdown 3
push 200
assertEqual

; A target outside the included source stays unchanged.
call delegated 10
push 15
assertEqual
moduleEnd
entryEnd
