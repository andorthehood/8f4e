8f4e/v1

includes
include std/memory/nearestValue
includesEnd

entry test
module nearestValueIntAssertions
; it selects the nearest int
; value from a buffer.
int[] values 5 -10 -2 4 11 20
int[] ties 2 0 10

push 5
push &values
push count(values)
call nearestValue
push 4
assertEqual

push -7
push &values
push count(values)
call nearestValue
push -10
assertEqual

push 5
push &ties
push count(ties)
call nearestValue
push 0
assertEqual

push 99
push &values
push 0
call nearestValue
push 0
assertEqual
moduleEnd

module nearestValueFloatAssertions
; it selects the nearest float
; value from a buffer.
float[] values 4 -1.0 0.25 0.75 2.0
float[] ties 2 0.25 0.75

push 0.6
push &values
push count(values)
call nearestValue
push 0.75
assertEqual

push -0.8
push &values
push count(values)
call nearestValue
push -1.0
assertEqual

push 0.5
push &ties
push count(ties)
call nearestValue
push 0.25
assertEqual

push 99.0
push &values
push 0
call nearestValue
push 0.0
assertEqual
moduleEnd
entryEnd
