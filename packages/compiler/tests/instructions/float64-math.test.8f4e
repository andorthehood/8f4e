8f4e/v1

note
; @config runtime TestRuntime

Float64 arithmetic and
comparison behavior should
execute
without falling back to
float32.
noteEnd

entry test
module float64ComparisonAssertions
; Float64 comparisons should
; produce integer booleans for
; matching operand widths.
push 1.5f64
push 1.5f64
equal
assertEqual 1

push 1.25f64
push 2.5f64
lessThan
assertEqual 1

push 2.5f64
push 1.25f64
greaterThan
assertEqual 1

push 1.25f64
push 1.25f64
lessOrEqual
assertEqual 1

push 2.5f64
push 1.25f64
greaterOrEqual
assertEqual 1

push 2.5f64
push 1.25f64
greaterOrEqualUnsigned
assertEqual 1
moduleEnd

module float64SqrtAssertions
; sqrt should operate on float64
; values when given a float64
; operand.
push 2.0f64
sqrt
assertEqual 1.4142135623730951f64
moduleEnd
entryEnd
