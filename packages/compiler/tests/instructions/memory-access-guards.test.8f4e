8f4e/v1

note
Guarded memory access should
return zero instead of
trapping
for unsafe addresses.
noteEnd

entry test
module guardedIntLoadAssertions
; Unsafe integer loads should
; return zero instead of
; trapping.
push -1
load
push 0
assertEqual

push 65533
load
push 0
assertEqual

push 2147483647
load
push 0
assertEqual
moduleEnd

module guardedFloatLoadAssertions
; Unsafe float loads should
; return zero instead of
; trapping.
push -1
loadFloat
push 0.0
assertEqual

push 65533
loadFloat
push 0.0
assertEqual

push 2147483647
loadFloat
push 0.0
assertEqual
moduleEnd

module guardedLocalPointerDereferenceAssertions
; Unsafe pointer dereferences
; inside impure functions should
; return zero.
int value

push &value
push 4
sub
call readGuardedPointer
push 0
assertEqual

push &value
push 65533
add
call readGuardedPointer
push 0
assertEqual

push &value
push 2147483647
add
call readGuardedPointer
push 0
assertEqual
moduleEnd
entryEnd

function readGuardedPointer
#impure
param int* ptr

push *ptr
functionEnd int
