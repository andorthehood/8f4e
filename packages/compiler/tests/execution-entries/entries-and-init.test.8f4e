8f4e/v1

note
Entries compile into
independent exported
dispatchers, and
functions can call them
explicitly.
noteEnd

entry main
module mainEntryCounter
int value 0

push &value
push value
push 1
add
store
moduleEnd
entryEnd

entry aux
module auxEntryCounter
int value 0

push &value
push value
push 2
add
store
moduleEnd
entryEnd

entry init
module userInitEntryCounter
int value 0

push &value
push 7
store
moduleEnd
entryEnd

function test
#export
#impure
; initDefaults runs before this
; function, but it should not
; execute the user-authored init
; entry.
push &userInitEntryCounter:value
load
assertEqual 0

call main
push &mainEntryCounter:value
load
assertEqual 1

call aux
push &auxEntryCounter:value
load
assertEqual 2

call init
push &userInitEntryCounter:value
load
assertEqual 7
functionEnd
