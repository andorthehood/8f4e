{
  "outDir": "logs/bundle-sizes",
  "packages": {
    "@8f4e/editor": {
      "label": "Editor App",
      "distDir": "packages/editor/dist",
      "entries": [
        {
          "name": "index.js",
          "pattern": "^assets/entries/index-[A-Za-z0-9_-]+\\.js$"
        }
      ]
    },
    "@8f4e/editor-core": {
      "label": "Editor Core",
      "distDir": "packages/editor/packages/editor-core/dist",
      "entries": [
        {
          "name": "index.js",
          "pattern": "^index\\.js$"
        }
      ]
    },
    "@8f4e/editor-state": {
      "label": "Editor State",
      "distDir": "packages/editor/packages/editor-core/packages/editor-state/dist",
      "entries": [
        {
          "name": "index.js",
          "pattern": "^index\\.js$"
        },
        {
          "name": "testing.js",
          "pattern": "^testing\\.js$"
        }
      ]
    },
    "@8f4e/compiler": {
      "label": "Compiler",
      "distDir": "packages/compiler/dist",
      "entries": [
        {
          "name": "index.js",
          "pattern": "^index\\.js$"
        }
      ]
    },
    "@8f4e/web-ui": {
      "label": "Web UI",
      "distDir": "packages/editor/packages/editor-core/packages/web-ui/dist",
      "entries": [
        {
          "name": "index.js",
          "pattern": "^index\\.js$"
        }
      ]
    },
    "@8f4e/sprite-generator": {
      "label": "Sprite Generator",
      "distDir": "packages/editor/packages/editor-core/packages/web-ui/packages/sprite-generator/dist",
      "entries": [
        {
          "name": "index.js",
          "pattern": "^index\\.js$"
        }
      ]
    }
  }
}
