8f4e/v1

includes
include std/bitwise/extractByte
includesEnd

entry test
module extractByteIntAssertions
; it extracts bytes from an
; integer word starting at the
; least-significant byte.
push 0x12345678
push 0
call extractByte
push 0x78
assertEqual

push 0x12345678
push 1
call extractByte
push 0x56
assertEqual

push 0x12345678
push 2
call extractByte
push 0x34
assertEqual

push 0x12345678
push 3
call extractByte
push 0x12
assertEqual

push -1
push 2
call extractByte
push 0xFF
assertEqual
moduleEnd
entryEnd
