8f4e/v1

includes
include std/events/gateToTrigger
includesEnd

entry test
module gateToTriggerIntAssertions
; it emits a one-sample trigger
; when an int gate rises.
int previousInt

push 0
call gateToTrigger &previousInt
push 0
assertEqual
push previousInt
push 0
assertEqual

push 1
call gateToTrigger &previousInt
push 1
assertEqual
push previousInt
push 1
assertEqual

push 1
call gateToTrigger &previousInt
push 0
assertEqual

push 0
call gateToTrigger &previousInt
push 0
assertEqual

push 1
call gateToTrigger &previousInt
push 1
assertEqual
moduleEnd

module gateToTriggerFloatAssertions
; it emits a one-sample trigger
; when a float gate rises.
float previousFloat

push 0.0
call gateToTrigger &previousFloat
push 0
assertEqual
push previousFloat
push 0.0
assertEqual

push 0.25
call gateToTrigger &previousFloat
push 1
assertEqual
push previousFloat
push 0.25
assertEqual

push 0.25
call gateToTrigger &previousFloat
push 0
assertEqual

push -0.5
call gateToTrigger &previousFloat
push 0
assertEqual

push 0.0
call gateToTrigger &previousFloat
push 1
assertEqual
moduleEnd
entryEnd
