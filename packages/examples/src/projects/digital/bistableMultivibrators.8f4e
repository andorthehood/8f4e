note
; @pos 45 5
; Demonstrates a bistable SR latch
; (multivibrator) built from feedback
; logic gates, with set/reset button
; inputs and scope buffers that
; visualize both latch state and
; derived gate output over time.
noteEnd

entry main
module setButton
; @pos 45 16
; @home left

int out
               ; Push this button
               ; to set the state
; @button &out  

moduleEnd
module resetButton
; @pos 45 27

int out
               ; Push this button
               ; to reset the state
; @button &out

moduleEnd
module norGate2
; @pos 95 8

                        ;   .---.
int* in1 &norGate:out   ; --+    '
int out                 ;   ) NOR |O---
int* in2 &setButton:out ; --+    .
                        ;   '---'
; @watch out

push &out
push *in1
push *in2
add
push 0
equal
if
push 1
else
push 0
ifEnd int
store

moduleEnd
module norGate
; @pos 95 34

                          ;   .---.
int* in1 &norGate2:out    ; --+    '
int out                   ;   ) NOR |O---
int* in2 &resetButton:out ; --+    .
                          ;   '---'
; @watch out

push &out
push *in1
push *in2
add
push 0
equal
if
push 1
else
push 0
ifEnd int
store

moduleEnd
module scope
; @pos 150 21

int* in &norGate:out
int[] buffer 64
int bufferPointer &buffer

; @plot &buffer count(buffer) -1 2

push &bufferPointer
push bufferPointer
push sizeof(buffer)
add
store

push bufferPointer
push buffer&
greaterThan
if
push &bufferPointer
push &buffer
store
ifEnd

push bufferPointer
push *in
store

moduleEnd
