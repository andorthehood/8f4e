note
Guard helpers normalize
invalid runtime values into
safe stack
values.
noteEnd

entry test
module ensureNonZeroIntAssertions
; ensureNonZero leaves non-zero
; integers unchanged and
; replaces
; zero with one.
push 69
ensureNonZero
push 69
assertEqual

push 0
ensureNonZero
push 1
assertEqual

push -420
ensureNonZero
push -420
assertEqual
moduleEnd

module ensureNonZeroFloatAssertions
; ensureNonZero leaves non-zero
; floats unchanged and replaces
; zero with 1.0.
push 69.1
ensureNonZero
push 69.1
assertEqual

push 0.0
ensureNonZero
push 1.0
assertEqual

push -420.1
ensureNonZero
push -420.1
assertEqual
moduleEnd
entryEnd
