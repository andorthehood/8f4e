8f4e/v1

note
Bitwise instruction behavior
is checked with native
assertions.
noteEnd

entry test
module andAssertions
; `and` should return only the
; bits present in both operands.
push 1
push 0
and
assertEqual 0

push 3
push 6
and
assertEqual 2
moduleEnd

module orAssertions
; `or` should return the bits
; present in either operand.
push 1
push 0
or
assertEqual 1

push 3
push 6
or
assertEqual 7
moduleEnd

module xorAssertions
; `xor` should return only bits
; that differ between operands.
push 1
push 0
xor
assertEqual 1

push 3
push 6
xor
assertEqual 5
moduleEnd

module shiftLeftAssertions
; shiftLeft moves integer bits
; left by the requested amount.
push 1
push 1
shiftLeft
assertEqual 2

push 1
push 2
shiftLeft
assertEqual 4

push 3
push 3
shiftLeft
assertEqual 24
moduleEnd

module shiftRightAssertions
; shiftRight moves integer bits
; right by the requested amount.
push 1
push 1
shiftRight
assertEqual 0

push 8
push 2
shiftRight
assertEqual 2

push 12
push 3
shiftRight
assertEqual 1
moduleEnd
entryEnd
