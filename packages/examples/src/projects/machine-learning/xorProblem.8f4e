module notes
; @pos 67 -75
; This is a compact, pre-trained
; neural network that solves the
; XOR problem by combining two
; input switches through hidden
; perceptrons with sigmoid
; activations and outputting a
; binary classification result.
moduleEnd
module inputs
; @pos 74 -64
; @home left

; You can change the
; input values here:
float in1 1.0
float in2 0.0

moduleEnd
module perceptron
; @pos 118 -82
; Pre-trained perceptron

float* in1 &inputs:in1
float* in2 &inputs:in2
float out

; Weights
const W1 10.056234
const W2 -42.53689
const BIAS -3.92453

push &out
push *in1
push W1
mul
push *in2
push W2
mul
add
push BIAS
add
store
moduleEnd
