8f4e/v1

note
The functionEnd return
declarations define the value
passed back to callers.
noteEnd

entry test
module functionEndIntReturn
; functionEnd int should return
; an integer stack value to the
; caller.
call getFunctionEndFortyTwo
push 42
assertEqual
moduleEnd

module functionEndFloatReturn
; functionEnd float should
; return a float stack value to
; the
; caller.
call getFunctionEndPi
push 3.14
assertEqual
moduleEnd

module functionEndStackValidationRuntimeResult
; functionEnd should accept a
; computed stack value when the
; result type matches.
call addTwoForFunctionEnd
push 8
assertEqual
moduleEnd

module functionEndFloat64Return
; functionEnd float64 should
; return a double-precision
; stack
; value to the caller.
call getFunctionEndDouble
push 3.14f64
assertEqual
moduleEnd

module functionEndFloat64SignatureSnapshot
; The compile-result snapshot
; records the float64 return
; signature for this function.
call getDoubleForSignatureSnapshot
push 3.14f64
assertEqual
moduleEnd
entryEnd

function getFunctionEndFortyTwo
push 42
functionEnd int

function getFunctionEndPi
push 3.14
functionEnd float

function addTwoForFunctionEnd
push 5
push 3
add
functionEnd int

function getFunctionEndDouble
push 3.14f64
functionEnd float64

function getDoubleForSignatureSnapshot
push 3.14f64
functionEnd float64
