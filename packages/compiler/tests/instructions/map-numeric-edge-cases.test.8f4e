module mapFloatKeyPrecisionAssertions
; Distinct source keys round to the
; same float32 key. The earlier row
; still wins. Float64 distinguishes
; those same source keys.
push 16777216.0
mapBegin float
map 16777216.0 10
map 16777217.0 20
default -7
mapEnd int
push 10
assertEqual

push 16777217.0
mapBegin float
map 16777216.0 10
map 16777217.0 20
default -7
mapEnd int
push 10
assertEqual

push 16777218.0
mapBegin float
map 16777216.0 10
map 16777217.0 20
default -7
mapEnd int
push -7
assertEqual

push 16777216.0f64
mapBegin float64
map 16777216.0f64 10
map 16777217.0f64 20
default -7
mapEnd int
push 10
assertEqual

push 16777217.0f64
mapBegin float64
map 16777216.0f64 10
map 16777217.0f64 20
default -7
mapEnd int
push 20
assertEqual

push 16777218.0f64
mapBegin float64
map 16777216.0f64 10
map 16777217.0f64 20
default -7
mapEnd int
push -7
assertEqual

moduleEnd

module mapSignedZeroFloatAssertions
; Read the result bits so negative
; zero cannot pass as positive zero.
float result

push &result
push 0.0
mapBegin float
map 0.0 -0.0
map -0.0 5.0
