entry main
module pcmPlayer
; @pos 29 -34
; @home left
use env

int16[] buffer ASSET_PIANO_SIZE/2
; @config bin.piano.memory buffer
int16* playhead &buffer
float out

; @wave2 &buffer count(buffer) playhead

; Read sample at playhead
; write it to output
push &out
push *playhead
castToFloat
push max(buffer)
castToFloat
div
store

; Advance the playhead
push &playhead
push playhead
push sizeof(buffer)
add
store

; Reset playhead
; when reaches buffer end
push playhead
push buffer&
greaterThan
if
push &playhead
push &buffer
store
ifEnd

moduleEnd
module audiooutL
; @pos 143 -34
use env

float* in &reverb:outL

float[] buffer AUDIO_BUFFER_SIZE
float* pointer &buffer

; @wave2 &buffer count(buffer)

; Store the input value
; in the buffer
push pointer
push *in
store

; Increment the buffer 
; pointer by the word size
push &pointer
push pointer
push sizeof(buffer) 
add
store

; Reset the buffer pointer
; when it reaches the end
; of the buffer
push pointer
push buffer& 
greaterThan 
if
push &pointer
push &buffer
store
ifEnd

moduleEnd
