8f4e/v1

note
; @pos -69 -13
; @home left
; @config export.fileName overlayTexture
; @config webUI.overlay.entry main
; @config webUI.overlay.target screen:rgba
; @config webUI.overlay.width 32
; @config webUI.overlay.height 18
; @config webUI.overlay.magnification 16
; @config webUI.overlay.filter nearest

; The main entry runs once per editor
; frame and fills a 32 x 18 RGBA8
; image. Its translucent pixels are
; magnified and centered over the editor.

noteEnd

entry main
module screen
; @pos -20 -10
; @home

const WIDTH 32
const HEIGHT 18
const PIXEL_COUNT WIDTH*HEIGHT

int frame
int8u[] rgba PIXEL_COUNT*4

; Advance the animation.
push &frame
push frame
push 1
add
store

loop PIXEL_COUNT
; Push channels in reverse order because
; storeBytes writes them in pop order.

; Alpha keeps the editor visible.
push 112

; Blue: diagonal gradient.
loopIndex
push WIDTH-1
and
loopIndex
push WIDTH
div
add
push 8
mul
push frame
push 3
mul
add
push 255
and

; Green: vertical gradient.
loopIndex
push WIDTH
div
push 14
mul
push frame
push 2
mul
add
push 255
and

; Red: horizontal gradient.
loopIndex
push WIDTH-1
and
push 8
mul
push frame
add
push 255
and

; Store one RGBA pixel.
push &rgba
loopIndex
push 4
mul
add
storeBytes 4
loopEnd

moduleEnd
entryEnd
