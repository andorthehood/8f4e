8f4e/v1

note
; @config runtime TestRuntime

Loop counters keep distinct
storage from locals declared
after an earlier loop. Explicit
caps override the directive.
noteEnd

entry test
module loopLocalStorageAssertions
call capped
assertEqual 2
assertEqual 1
moduleEnd
entryEnd

function capped
#export
#loopCap 2
local int total
loop
loopIndex
localSet total
loopEnd
push total
local int late
loop 3
loopIndex
localSet late
loopEnd
push late
functionEnd int int
