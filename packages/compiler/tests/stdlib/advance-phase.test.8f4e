8f4e/v1

includes
include std/math/trig/advancePhase
includesEnd

entry test
module advancePhaseAssertions
; it advances phase by one
; sample in the [-PI, PI] range.
float phase 0.0

push &phase
push 1.0
push 4
call advancePhase
push 1.570796326794896
assertEqual

push phase
push 1.570796326794896
assertEqual

; it wraps to the lower bound
; after crossing the upper bound.
push &phase
push 2.0
push 4
call advancePhase
push -3.141592653589793
assertEqual

push phase
push -3.141592653589793
assertEqual
moduleEnd
entryEnd
