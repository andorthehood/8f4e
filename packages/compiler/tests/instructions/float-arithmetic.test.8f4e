8f4e/v1

note
Float instruction behavior is
checked with native
assertions.
noteEnd

entry test
module floatMulAssertions
; Float multiplication is
; approximate because
; WebAssembly stores
; these values as floats.
push 4.001
push 0.5
mul
push 2.0
; Absolute error is bounded
; by 0.001.
sub
abs
push 0.001
lessOrEqual
assert
moduleEnd

module floatDivAssertions
; Float division checks an
; explicit absolute error bound.
push 420.001
push 69.001
ensureNonZero
div
push 6.0869
; Absolute error is bounded
; by 0.001.
sub
abs
push 0.001
lessOrEqual
assert
moduleEnd

module floatAbsAssertions
; abs returns positive float
; magnitudes.
push 1.1
abs
push 1.1
assertEqual

push -1.1
abs
push 1.1
assertEqual

push -69.1
abs
push 69.1
assertEqual

push 420.1
abs
push 420.1
assertEqual
moduleEnd

module castToFloatAssertions
; castToFloat should preserve
; integer magnitude when
; converting
; to float.
push 1
castToFloat
push 1.0
assertEqual

push -69
castToFloat
push -69.0
assertEqual

push 0
castToFloat
push 0.0
assertEqual

push 420
castToFloat
push 420.0
assertEqual
moduleEnd

module castToIntAssertions
; castToInt truncates toward
; zero.
push 1.1
castToInt
push 1
assertEqual

push -69.69
castToInt
push -69
assertEqual

push 0.001
castToInt
push 0
assertEqual

push 420.99
castToInt
push 420
assertEqual
moduleEnd

module roundAssertions
; round follows the compiler's
; current half-down behavior.
push 4.1
round
push 4.0
assertEqual

push 4.5
round
push 4.0
assertEqual

push 4.51
round
push 5.0
assertEqual

push 4.6
round
push 5.0
assertEqual

push 4.9
round
push 5.0
assertEqual
moduleEnd

module sqrtAssertions
; sqrt returns approximate float
; square roots.
push 4.001
sqrt
push 2.0
; Absolute error is bounded
; by 0.001.
sub
abs
push 0.001
lessOrEqual
assert

push 16.001
sqrt
push 4.0
; Absolute error is bounded
; by 0.001.
sub
abs
push 0.001
lessOrEqual
assert
moduleEnd
entryEnd
