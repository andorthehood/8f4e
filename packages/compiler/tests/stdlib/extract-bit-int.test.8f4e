module extractBitIntAssertions
; it extracts individual bits
; from an integer word starting
; at the least-significant bit.
push 0b10100100
push 0
call extractBit
push 0
assertEqual

push 0b10100100
push 2
call extractBit
push 1
assertEqual

push 0b10100100
push 5
call extractBit
push 1
assertEqual

push 0b10100100
push 6
call extractBit
push 0
assertEqual

push -1
push 31
call extractBit
push 1
assertEqual
