8f4e/v1

note
describes a reusable module
memory shape with defaults
noteEnd

prototype oscillatorState
float phase
float frequency 440
prototypeEnd

entry test
module oscA
shape oscillatorState
int localA 11

; it expands prototype fields
; before local declarations
push phase
push 0.0
assertEqual

; it preserves default values
; from prototype fields
push frequency
push 440.0
assertEqual

; it preserves declarations
; written in the consuming
; module
push localA
push 11
assertEqual

; it lays out expanded prototype
; fields in declaration order
push &phase
push &frequency
lessThan
push 1
assertEqual

; it lays out local declarations
; after a leading shape
; instruction
push &frequency
push &localA
lessThan
push 1
assertEqual
moduleEnd

module oscB
int localB 22
shape oscillatorState

; it preserves declarations that
; appear before a shape
; instruction
push localB
push 22
assertEqual

; it expands prototype fields
; after earlier local
; declarations
push phase
push 0.0
assertEqual

; it reuses prototype defaults
; in each consuming module
push frequency
push 440.0
assertEqual

; it lays out shape fields after
; preceding local declarations
push &localB
push &phase
lessThan
push 1
assertEqual

; it allocates separate storage
; for each module that uses the
; shape
push &phase
push &oscA:phase
notEqual
push 1
assertEqual
moduleEnd
entryEnd
