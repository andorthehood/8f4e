8f4e/v1

note
Literal and constant
expressions are executed as
regular
language tests.
noteEnd

entry test
module validConstantNameAssertions
; Constants with valid names are
; available as int, float, and
; declaration defaults.
const TEST1 420
const TEST2 420.69
const TEST3 69

push TEST1
push 420
assertEqual

push TEST2
push 420.69
assertEqual

int output3 TEST3
push output3
push 69
assertEqual
moduleEnd

module fractionLiteralAssertions
; Fraction literals work in
; push, memory declarations, and
; constants.
push 1/16
push 0.0625
assertEqual

int intFraction 1/16
push intFraction
push 0
assertEqual

float floatFraction 1/16
push floatFraction
push 0.0625
assertEqual

int intWholeFraction 8/2
push intWholeFraction
push 4
assertEqual

float negativeFraction -1/2
push negativeFraction
push -0.5
assertEqual

const MY_FRACTION 1/8
push MY_FRACTION
push 0.125
assertEqual
moduleEnd

module literalMulDivExpressionAssertions
; Literal-only multiplication
; and division fold in const,
; push,
; and memory contexts.
const MUL_RESULT 16*2
push MUL_RESULT
push 32
assertEqual

const DIV_RESULT 8/2
push DIV_RESULT
push 4
assertEqual

push 16*2
push 32
assertEqual

push 1/2
push 0.5
assertEqual

push 0x10*2
push 32
assertEqual

push 0x10/2
push 8
assertEqual

push 3.5*4
push 14.0
assertEqual

int multipliedDefault 4*3
push multipliedDefault
push 12
assertEqual

int[] literalSizedBuffer 4*2
push count(literalSizedBuffer)
push 8
assertEqual
moduleEnd

module constantExpressionAssertions
; Constants can reference
; constants and shape memory
; sizes.
const SIZE 8
int[] dividedBuffer SIZE/2
push count(dividedBuffer)
push 4
assertEqual

int[] multipliedBuffer SIZE*2
push count(multipliedBuffer)
push 16
assertEqual

const HALF SIZE/2
push HALF
push 4
assertEqual

const SIGNED -1/SIZE
push SIGNED
push -0.125
assertEqual

push SIZE/2
push 4
assertEqual

int defaultFromExpression SIZE/2
push defaultFromExpression
push 4
assertEqual
moduleEnd

module sizeAndCountExpressionAssertions
; sizeof and count expressions
; work in push and buffer sizing.
int16[] samples 4
push sizeof(samples)*2
push 4
assertEqual

const SIZE 8
push SIZE*sizeof(samples)
push 16
assertEqual

push sizeof(samples)*4
push 8
assertEqual

push 123*sizeof(samples)
push 246
assertEqual

push 2*SIZE
push 16
assertEqual

float[] floatSamples 8
float* ptr &floatSamples
push count(*ptr)
push 8
assertEqual

int8[] smallSamples 4
int8* smallPtr &smallSamples
push min(*smallPtr)
push -128
assertEqual

moduleEnd

module exponentExpressionAssertions
; Exponent expressions are
; supported for constants, push
; values,
; and buffer sizes.
const WIDTH 2^16
push WIDTH
push 65536
assertEqual

const SIZE 4
const TOTAL SIZE^3
push TOTAL
push 64
assertEqual

const EXP 8
const RESULT 2^EXP
push RESULT
push 256
assertEqual

push 2^SIZE
push 16
assertEqual

const MEMORY_EXP 3
int defaultFromExponent MEMORY_EXP^2
push defaultFromExponent
push 9
assertEqual

const BUFFER_BASE 2
int[] exponentialBuffer BUFFER_BASE^3
push count(exponentialBuffer)
push 8
assertEqual

int32[] samples 4
push sizeof(samples)^2
push 16
assertEqual
moduleEnd
entryEnd
