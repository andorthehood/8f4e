module lfo1
; @pos 90 -27
; @group smearStage1

use env

float frequency 0.5
float phase
float out

push &out
push &phase
push frequency
push SAMPLE_RATE
call advancePhase
; You can swap this call
; with any periodic function
call cosine

push 1.0
add
push 2.0
div

store

moduleEnd
module modulatedDelayTap
; @pos 127 -27
; @group smearStage1
; Reads a modulated, 
; interpolated tap 
; from a delay buffer
use cloudsReverb

float* buffer 
- &allpassDiffuser:buffer
float** pointer 
- &allpassDiffuser:pointer
float* mod &lfo1:out
float out

const MOD_BASE_OFFSET 
- 10.0*CLOUDS_RATIO
const MOD_DEPTH 
- 60.0*CLOUDS_RATIO

push &out
; pointer + 
; int((10 + mod * 60) * ratio) * sizeof(*buffer)
push *pointer
push MOD_BASE_OFFSET
push *mod
push MOD_DEPTH
mul
add
castToInt
push sizeof(*buffer)
mul
add

; Circular buffer range
push buffer
push count(*buffer)

; fraction((10 + mod * 60) * ratio)
push MOD_BASE_OFFSET
push *mod
push MOD_DEPTH
mul
add
call fract

call readInterpolated
store

moduleEnd
module reverbInput
; @pos 160 -41

float* in

moduleEnd
module delayOffsetWriter
; @pos 173 -27
; @group smearStage1
; Writes an input sample into a
; shared delay buffer at a fixed
; offset from the current
; circular pointer.
use cloudsReverb

float* buffer 
- &allpassDiffuser:buffer
float** pointer 
- &allpassDiffuser:pointer
float* in &modulatedDelayTap:out

const WRITE_OFFSET_SAMPLES 
- 100.0*CLOUDS_RATIO

push *pointer
push WRITE_OFFSET_SAMPLES
castToInt
push sizeof(*buffer)
mul
add
push buffer
push count(*buffer)
call wrapPointer
push *in
store

moduleEnd
module allpassDiffuser
; @pos 214 -27
; @group smearStage1
use cloudsReverb

const DELAY_SIZE round(113*CLOUDS_RATIO)

float** in &reverbInput:in
float out
float[] buffer DELAY_SIZE
float* pointer &buffer 
float* diffusion 
- &controlValues:diffusion

; @wave2 &buffer count(buffer) pointer

local float writeValue 

push **in
push *pointer
push *diffusion
mul
add
localSet writeValue

push &out
push *pointer
push writeValue
push *diffusion
mul
sub
store

; Store the allpass
; write value
push pointer
push writeValue
store 

; Advance and wrap
; circular buffer pointer
push &pointer
push &buffer
push count(buffer)
call advancePointer

moduleEnd
