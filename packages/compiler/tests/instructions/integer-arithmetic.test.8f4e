8f4e/v1

note
Integer arithmetic behavior is
checked with native
assertions.
noteEnd

entry test
module addAssertions
; Addition keeps signed integer
; behavior across positive,
; negative, and zero operands.
push 2
push 2
add
push 4
assertEqual

push -1
push 1
add
push 0
assertEqual

push -69
push 0
add
push -69
assertEqual

push 420
push 0
add
push 420
assertEqual
moduleEnd

module subAssertions
; Subtraction keeps signed
; integer behavior across
; positive,
; negative, and zero operands.
push 2
push 2
sub
push 0
assertEqual

push -1
push 1
sub
push -2
assertEqual

push -69
push 0
sub
push -69
assertEqual

push 420
push 0
sub
push 420
assertEqual
moduleEnd

module mulAssertions
; Multiplication handles
; ordinary products and zero
; operands.
push 2
push 2
mul
push 4
assertEqual

push 2
push 0
mul
push 0
assertEqual
moduleEnd

module divAssertions
; Division works with a non-zero
; guard on the divisor.
push 100
push 10
ensureNonZero
div
push 10
assertEqual
moduleEnd

module remainderAssertions
; remainder works when the
; divisor is guarded as
; non-zero.
push 4
push 2
ensureNonZero
remainder
push 0
assertEqual

push 3
push 2
ensureNonZero
remainder
push 1
assertEqual
moduleEnd

module absAssertions
; abs returns positive integer
; magnitudes.
push 1
abs
push 1
assertEqual

push -1
abs
push 1
assertEqual

push -69
abs
push 69
assertEqual

push 420
abs
push 420
assertEqual

push 8
push -2
abs
div
push 4
assertEqual
moduleEnd
entryEnd
