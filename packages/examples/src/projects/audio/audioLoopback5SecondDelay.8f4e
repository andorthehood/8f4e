note
; @pos 175 12
; This is a stereo loopback example
; that delays the input audio by five
; seconds before writing the signal
; into the left and right output
; buffers.
noteEnd

entry main
module audioin
; @pos 5 1
use env

; Audio buffer
float[] buffer AUDIO_BUFFER_SIZE
float out
int pointer &buffer

; @plot &buffer count(buffer)

push &out
push pointer
loadFloat
store

push &pointer
push pointer
push sizeof(buffer)
add
store

push pointer
push buffer&
greaterThan
if
push &pointer
push &buffer
store
ifEnd

moduleEnd
module delay
; @pos 48 1
; @home
use env

const DELAY_BUFFER_SIZE SAMPLE_RATE*5

float* in &audioin:out
float out
float[] buffer DELAY_BUFFER_SIZE
int pointer &buffer

; Read the five-second-old sample
push &out
push pointer
loadFloat
store

; Replace it with the current sample
push pointer
push *in
store

; Advance and wrap the circular buffer pointer
push &pointer
push pointer
push sizeof(buffer)
add
store

push pointer
push buffer&
greaterThan
if
push &pointer
push &buffer
store
ifEnd

moduleEnd
