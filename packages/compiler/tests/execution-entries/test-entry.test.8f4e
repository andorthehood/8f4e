8f4e/v1

note
; @config runtime TestRuntime

The main entry should compile,
but the fixture runner only
executes the test entry.
noteEnd

entry main
module productionEntryDoesNotRun
push 1
push 2
add
assertEqual 4
moduleEnd
entryEnd

note
Test entry modules are executed
by the compiler fixture runner.
noteEnd

entry test
module testEntryRunsAssertions
push 1
push 2
add
assertEqual 3
moduleEnd

module testEntrySupportsPointerArguments
; Test modules can declare
; memory and pass addresses into
; imported or user-defined
; functions.
int[] values 2 7 8
push &values
call readFirst
assertEqual 7
moduleEnd
entryEnd

function readFirst
#impure
param int* pointer
; Helper used by the
; pointer-address test module.
push *pointer
functionEnd int
