entry main
module add
; @pos 28 -5
; @home left

; Add two numbers.

; First, push the numbers
; you want to add
; onto the stack:
push 40


push 2

; Use the @stack directive
; to inspect the contents
; of the stack:
; @stack

; Invoke the add
; instruction:
add

; The result is on the
; @stack

; Clear the stack:
drop

moduleEnd
module div
; @pos 65 -5

; Divide two numbers.

; First, push the numbers
; you want to divide
; onto the stack:
push 355.0
push 113.0

; Invoke the div
; instruction:
div

; The result is on the
; @stack

drop ; Clear the stack.

moduleEnd
module many
