assertEqual
moduleEnd

module triggerToGateFloatAssertions
; it treats positive float
; values as triggers.
int remainingSamples

push 0.0
push 2
call triggerToGate &remainingSamples
push 0
assertEqual

push 0.5
push 2
call triggerToGate &remainingSamples
push 1
assertEqual
push remainingSamples
push 1
assertEqual

push -0.5
push 2
call triggerToGate &remainingSamples
push 1
assertEqual
push remainingSamples
push 0
assertEqual

push 0.0
push 2
call triggerToGate &remainingSamples
push 0
assertEqual
moduleEnd
entryEnd
