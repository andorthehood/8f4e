module triggerToGateIntAssertions
; it holds an int trigger open
; for the requested duration.
int remainingSamples

push 0
push 3
call triggerToGate &remainingSamples
push 0
assertEqual
push remainingSamples
push 0
assertEqual

push 1
push 3
call triggerToGate &remainingSamples
push 1
assertEqual
push remainingSamples
push 2
assertEqual

push 0
push 3
call triggerToGate &remainingSamples
push 1
assertEqual
push remainingSamples
push 1
assertEqual

push 0
push 3
call triggerToGate &remainingSamples
push 1
assertEqual
push remainingSamples
push 0
assertEqual

push 0
push 3
call triggerToGate &remainingSamples
push 0
assertEqual

push 1
push 2
call triggerToGate &remainingSamples
push 1
assertEqual
push remainingSamples
push 1
assertEqual

push 1
push 4
call triggerToGate &remainingSamples
push 1
assertEqual
