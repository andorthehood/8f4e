8f4e/v1

note
; @config runtime TestRuntime

Every numeric input/output pair
preserves first-match precedence
and explicit defaults.
noteEnd

entry test
module mapNumericTypeAssertions

; int keys, int results.
call mapIntToInt 1
push 10
equal
assertEqual 1
call mapIntToInt 2
push 20
equal
assertEqual 1
call mapIntToInt 3
push -7
equal
assertEqual 1

; int keys, float results.
call mapIntToFloat 1
push 10.5
equal
assertEqual 1
call mapIntToFloat 2
push 20.5
equal
assertEqual 1
call mapIntToFloat 3
push -7.5
equal
assertEqual 1

; int keys, float64 results.
call mapIntToFloat64 1
push 10.5f64
equal
assertEqual 1
call mapIntToFloat64 2
push 20.5f64
equal
assertEqual 1
call mapIntToFloat64 3
push -7.5f64
equal
assertEqual 1

; float keys, int results.
call mapFloatToInt 1.0
push 10
equal
assertEqual 1
call mapFloatToInt 2.0
push 20
equal
assertEqual 1
call mapFloatToInt 3.0
push -7
equal
assertEqual 1

; float keys, float results.
call mapFloatToFloat 1.0
push 10.5
equal
assertEqual 1
call mapFloatToFloat 2.0
push 20.5
equal
assertEqual 1
call mapFloatToFloat 3.0
push -7.5
equal
assertEqual 1

; float keys, float64 results.
call mapFloatToFloat64 1.0
push 10.5f64
equal
assertEqual 1
call mapFloatToFloat64 2.0
push 20.5f64
equal
assertEqual 1
call mapFloatToFloat64 3.0
push -7.5f64
equal
assertEqual 1

; float64 keys, int results.
call mapFloat64ToInt 1.0f64
push 10
equal
assertEqual 1
call mapFloat64ToInt 2.0f64
push 20
equal
assertEqual 1
call mapFloat64ToInt 3.0f64
push -7
equal
assertEqual 1

; float64 keys, float results.
call mapFloat64ToFloat 1.0f64
push 10.5
equal
assertEqual 1
call mapFloat64ToFloat 2.0f64
push 20.5
equal
assertEqual 1
call mapFloat64ToFloat 3.0f64
push -7.5
equal
assertEqual 1

; float64 keys, float64 results.
call mapFloat64ToFloat64 1.0f64
push 10.5f64
equal
assertEqual 1
call mapFloat64ToFloat64 2.0f64
push 20.5f64
equal
assertEqual 1
call mapFloat64ToFloat64 3.0f64
push -7.5f64
equal
assertEqual 1
moduleEnd

module mapNonFiniteInputAssertions
; NaN and infinities cannot match
; finite keys. Compare results to
; finite defaults before asserting.

; float input, int result.
push -1.0
sqrt
call mapFloatToInt
push -7
equal
assertEqual 1
push 340282346638528859811704183484516925440.0
push 2.0
mul
call mapFloatToInt
push -7
equal
assertEqual 1
push 340282346638528859811704183484516925440.0
push 2.0
mul
push -1.0
mul
call mapFloatToInt
push -7
equal
assertEqual 1

; float input, float result.
push -1.0
sqrt
call mapFloatToFloat
push -7.5
equal
assertEqual 1
push 340282346638528859811704183484516925440.0
push 2.0
mul
call mapFloatToFloat
push -7.5
equal
assertEqual 1
push 340282346638528859811704183484516925440.0
push 2.0
mul
push -1.0
mul
call mapFloatToFloat
push -7.5
equal
assertEqual 1

; float input, float64 result.
push -1.0
sqrt
call mapFloatToFloat64
push -7.5f64
equal
assertEqual 1
push 340282346638528859811704183484516925440.0
push 2.0
mul
call mapFloatToFloat64
push -7.5f64
equal
assertEqual 1
push 340282346638528859811704183484516925440.0
push 2.0
mul
push -1.0
mul
call mapFloatToFloat64
push -7.5f64
equal
assertEqual 1

; float64 input, int result.
push -1.0f64
sqrt
call mapFloat64ToInt
push -7
equal
assertEqual 1
push 340282346638528859811704183484516925440.0
push 2.0
mul
castToFloat64
call mapFloat64ToInt
push -7
equal
assertEqual 1
push 340282346638528859811704183484516925440.0
push 2.0
mul
push -1.0
mul
castToFloat64
call mapFloat64ToInt
push -7
equal
assertEqual 1

; float64 input, float result.
push -1.0f64
sqrt
call mapFloat64ToFloat
push -7.5
equal
assertEqual 1
push 340282346638528859811704183484516925440.0
push 2.0
mul
castToFloat64
call mapFloat64ToFloat
push -7.5
equal
assertEqual 1
push 340282346638528859811704183484516925440.0
push 2.0
mul
push -1.0
mul
castToFloat64
call mapFloat64ToFloat
push -7.5
equal
assertEqual 1

; float64 input, float64 result.
push -1.0f64
sqrt
call mapFloat64ToFloat64
push -7.5f64
equal
assertEqual 1
push 340282346638528859811704183484516925440.0
push 2.0
mul
castToFloat64
call mapFloat64ToFloat64
push -7.5f64
equal
assertEqual 1
push 340282346638528859811704183484516925440.0
push 2.0
mul
push -1.0
mul
castToFloat64
call mapFloat64ToFloat64
push -7.5f64
equal
assertEqual 1
moduleEnd
entryEnd

function mapIntToInt
param int input
push input
mapBegin int
map 1 10
map 2 20
map 1 20
default -7
mapEnd int
functionEnd int

function mapIntToFloat
param int input
push input
mapBegin int
map 1 10.5
map 2 20.5
map 1 20.5
default -7.5
mapEnd float
functionEnd float

function mapIntToFloat64
param int input
push input
mapBegin int
map 1 10.5f64
map 2 20.5f64
map 1 20.5f64
default -7.5f64
mapEnd float64
functionEnd float64

function mapFloatToInt
param float input
push input
mapBegin float
map 1.0 10
map 2.0 20
map 1.0 20
default -7
mapEnd int
functionEnd int

function mapFloatToFloat
param float input
push input
mapBegin float
map 1.0 10.5
map 2.0 20.5
map 1.0 20.5
default -7.5
mapEnd float
functionEnd float

function mapFloatToFloat64
param float input
push input
mapBegin float
map 1.0 10.5f64
map 2.0 20.5f64
map 1.0 20.5f64
default -7.5f64
mapEnd float64
functionEnd float64

function mapFloat64ToInt
param float64 input
push input
mapBegin float64
map 1.0f64 10
map 2.0f64 20
map 1.0f64 20
default -7
mapEnd int
functionEnd int

function mapFloat64ToFloat
param float64 input
push input
mapBegin float64
map 1.0f64 10.5
map 2.0f64 20.5
map 1.0f64 20.5
default -7.5
mapEnd float
functionEnd float

function mapFloat64ToFloat64
param float64 input
push input
mapBegin float64
map 1.0f64 10.5f64
map 2.0f64 20.5f64
map 1.0f64 20.5f64
default -7.5f64
mapEnd float64
functionEnd float64
