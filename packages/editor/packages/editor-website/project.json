{
  "name": "@8f4e/editor-website",
  "sourceRoot": "src",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run-many --target=build --all && nx watch --all -- nx run-many --target=build --all",
          "vite"
        ],
        "parallel": true,
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check --write packages/editor/packages/editor-website/src",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["typecheck", "^build"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project tsconfig.json",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"]
    },
    "kill-dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "lsof -ti tcp:3000 | xargs -r kill",
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": ["type:application", "scope:editor"]
}
