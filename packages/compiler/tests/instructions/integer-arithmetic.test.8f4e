8f4e/v1

note
Integer arithmetic behavior is
checked through the shared
imported assert helper.
noteEnd

entry test
module addAssertions
; Addition keeps signed integer
; behavior across positive,
; negative, and zero operands.
push 2
push 2
add
call assert 4

push -1
push 1
add
call assert 0

push -69
push 0
add
call assert -69

push 420
push 0
add
call assert 420
moduleEnd

module subAssertions
; Subtraction keeps signed
; integer behavior across
; positive,
; negative, and zero operands.
push 2
push 2
sub
call assert 0

push -1
push 1
sub
call assert -2

push -69
push 0
sub
call assert -69

push 420
push 0
sub
call assert 420
moduleEnd

module mulAssertions
; Multiplication handles
; ordinary products and zero
; operands.
push 2
push 2
mul
call assert 4

push 2
push 0
mul
call assert 0
moduleEnd

module divAssertions
; Division works with a non-zero
; guard on the divisor.
push 100
push 10
ensureNonZero
div
call assert 10
moduleEnd

module remainderAssertions
; remainder works when the
; divisor is guarded as
; non-zero.
push 4
push 2
ensureNonZero
remainder
call assert 0

push 3
push 2
ensureNonZero
remainder
call assert 1
moduleEnd

module absAssertions
; abs returns positive integer
; magnitudes.
push 1
abs
call assert 1

push -1
abs
call assert 1

push -69
abs
call assert 69

push 420
abs
call assert 420

push 8
push -2
abs
div
call assert 4
moduleEnd
entryEnd
